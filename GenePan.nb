                RowBox[{"presel", ",", "#"}], "]"}], ",", "data"}], "]"}]}], 
            "]"}], "]"}], "]"}], "&"}], ",", "range"}], "]"}]}], ";", 
     RowBox[{"poslist", "=", 
      RowBox[{"First", "[", 
       RowBox[{"Flatten", "[", 
