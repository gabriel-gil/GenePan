     RowBox[{"datanormal", ",", "data"}], "]"}]}], ";", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<panel2.dat\>\"", ",", "panel"}], "]"}], ";"}], 
  "]"}]], "Input",
