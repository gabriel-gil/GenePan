Cell[BoxData[
 RowBox[{
  RowBox[{"sel", "=", 
   RowBox[{"Sort", "[", 
    RowBox[{
     RowBox[{"RA", "[", 
      RowBox[{"TumorH", ",", " ", "data"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"#1", ",", "TumorH"}], "]"}], "]"}], "]"}], ">", 
       RowBox[{"Total", "[", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"#2", ",", "TumorH"}], "]"}], "]"}], "]"}]}], "&"}]}], 
    "]"}]}], ";", 
  RowBox[{"totaltumor", "=", 
   RowBox[{"Length", "[", "TumorH", "]"}]}], ";", 
  RowBox[{"presel", "=", 
   RowBox[{"{", 
    RowBox[{"sel", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "}"}]}], ";", 
  RowBox[{"total", "=", 
   RowBox[{"Total", "[", 
    RowBox[{"Boole", "[", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"TumorH", ",", "#"}], "]"}], "&"}], ",", 
       RowBox[{"RE", "[", 
        RowBox[{"presel", ",", "data"}], "]"}]}], "]"}], "]"}], "]"}]}], 
  ";"}]], "Input",
