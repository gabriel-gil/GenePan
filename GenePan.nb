                  RowBox[{"(", 
                   RowBox[{"var", "-", "d"}], ")"}]}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"d", ",", "0", ",", "#"}], "}"}]}], "]"}], "&"}], 
