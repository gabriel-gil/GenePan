   RowBox[{"panel", " ", "2"}], ":", " ", 
   RowBox[{"only", " ", "tumors", " ", "above"}]}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.831891696561099*^9, 3.8318916968266935`*^9}, {
  3.837083859894154*^9, 3.8370838778399787`*^9}},
 FontFamily->"Consolas",
 FontSize->14,
 FontWeight->"Bold",ExpressionUUID->"31ac0f29-1978-43b3-84d1-32e6fb753356"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Timing", "[", 
  RowBox[{
   RowBox[{"whoconcept", "=", "\"\<Normal\>\""}], ";", "\[IndentingNewLine]", 
   RowBox[{"conceptextents", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whoconcept", "\[Equal]", "\"\<Tumor\>\""}], ",", "TumorH", ",",
       "NormalH"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"whorough", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whoconcept", "\[Equal]", "\"\<Tumor\>\""}], ",", 
      "\"\<Normal\>\"", ",", "\"\<Tumor\>\""}], "]"}]}], ";", 
   RowBox[{"roughextents", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whorough", "\[Equal]", "\"\<Normal\>\""}], ",", "NormalH", ",",
       "TumorH"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"data", "=", 
    RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"panel", "=", 
    RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"threshold", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"values", "[", 
         RowBox[{"[", 
          RowBox[{"conceptextents", ",", "i"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"aberrations", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"values", "[", 
          RowBox[{"[", 
           RowBox[{"roughextents", ",", "i"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"#", ">", "threshold"}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "aberrations", "]"}], ">", 
         RowBox[{"pvaluethreshold", "[", "whorough", "]"}]}], ",", 
        RowBox[{
         RowBox[{"threshold", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"threshold", "+", 
             RowBox[{"Min", "[", "aberrations", "]"}]}], ")"}], "/", "2"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"panel", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "threshold", ",", "2"}], "}"}]}], "]"}], ";", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"data", ",", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"g", "[", 
               RowBox[{"#", ",", "threshold"}], "]"}], "&"}], ",", 
