     RowBox[{"datanormal", ",", "data"}], "]"}]}], ";", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<panel4.dat\>\"", ",", "panel"}], "]"}], ";"}], 
  "]"}]], "Input",
