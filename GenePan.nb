          RowBox[{"conceptextents", ",", "i"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"thresholdup", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"values", "[", 
         RowBox[{"[", 
          RowBox[{"conceptextents", ",", "i"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"aberrations", "=", 
