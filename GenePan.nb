Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Timing", "[", 
  RowBox[{
   RowBox[{"whoconcept", "=", "\"\<Normal\>\""}], ";", "\[IndentingNewLine]", 
   RowBox[{"conceptextents", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whoconcept", "\[Equal]", "\"\<Tumor\>\""}], ",", "TumorH", ",",
       "NormalH"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"whorough", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whoconcept", "\[Equal]", "\"\<Tumor\>\""}], ",", 
      "\"\<Normal\>\"", ",", "\"\<Tumor\>\""}], "]"}]}], ";", 
   RowBox[{"roughextents", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whorough", "\[Equal]", "\"\<Normal\>\""}], ",", "NormalH", ",",
       "TumorH"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"data", "=", 
    RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"panel", "=", 
    RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"limit", "=", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"2", ",", "lowFPKM"}], "]"}], "-", 
        RowBox[{"Log", "[", 
         RowBox[{"2", ",", 
          RowBox[{"referenceN", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"threshold", "=", 
       RowBox[{"Min", "[", 
        RowBox[{"values", "[", 
         RowBox[{"[", 
          RowBox[{"conceptextents", ",", "i"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"aberrations", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"values", "[", 
          RowBox[{"[", 
           RowBox[{"roughextents", ",", "i"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "<", "threshold"}], "&&", 
           RowBox[{"#", ">", "limit"}]}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "aberrations", "]"}], ">", 
         RowBox[{"pvaluethreshold", "[", "whorough", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"threshold", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"threshold", "+", 
             RowBox[{"Max", "[", "aberrations", "]"}]}], ")"}], "/", "2"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"panel", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "threshold", ",", "4"}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"data", ",", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"g", "[", 
                  RowBox[{"#", ",", "threshold"}], "]"}]}], ")"}], 
               RowBox[{"g", "[", 
                RowBox[{"#", ",", "limit"}], "]"}]}], "&"}], ",", 
             RowBox[{"values", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "i"}], "]"}], "]"}]}], "]"}]}], "]"}]}]}], 
       "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"values", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], "}"}]}], "]"}], 
   ";", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"Boole", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"roughextents", ",", "#"}], "]"}], "&"}], ",", 
         RowBox[{"RE", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"1", ",", 
             RowBox[{"Length", "[", "data", "]"}]}], "]"}], ",", "data"}], 
          "]"}]}], "]"}], "]"}], "]"}], "/", 
     RowBox[{"Length", "[", "roughextents", "]"}]}], "]"}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"panellist", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"panellist", ",", "panel"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"panelnormal", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"panelnormal", ",", "panel"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"datanormal", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"datanormal", ",", "data"}], "]"}]}], ";", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<panel4.dat\>\"", ",", "panel"}], "]"}], ";"}], 
  "]"}]], "Input",
