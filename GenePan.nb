           RowBox[{"#1", "<=", "#2"}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"diff", "=", 
        RowBox[{"Differences", "[", "sorted", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pos", "=", 
