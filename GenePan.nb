      RowBox[{
       RowBox[{"list", "[", 
        RowBox[{"[", "poslist", "]"}], "]"}], "-", "total"}]}], ";", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"flag", "!=", "0"}], ",", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"presel", ",", 
         RowBox[{"range", "[", 
          RowBox[{"[", "poslist", "]"}], "]"}]}], "]"}]}], "]"}], ";", 
     RowBox[{"total", "=", 
      RowBox[{"list", "[", 
       RowBox[{"[", "poslist", "]"}], "]"}]}], ";", 
     RowBox[{"iter", "++"}]}]}], "]"}], ";"}]], "Input",
