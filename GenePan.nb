             RowBox[{"values", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "i"}], "]"}], "]"}]}], "]"}]}], "]"}]}]}], 
       "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"values", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], "}"}]}], "]"}], 
   ";", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
