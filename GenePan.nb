Cell[BoxData[
 RowBox[{"Timing", "[", 
  RowBox[{
   RowBox[{"whoconcept", "=", "\"\<Tumor\>\""}], ";", "\[IndentingNewLine]", 
   RowBox[{"conceptextents", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whoconcept", "\[Equal]", "\"\<Tumor\>\""}], ",", "TumorH", ",",
       "NormalH"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"whorough", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whoconcept", "\[Equal]", "\"\<Tumor\>\""}], ",", 
      "\"\<Normal\>\"", ",", "\"\<Tumor\>\""}], "]"}]}], ";", 
   RowBox[{"roughextents", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whorough", "\[Equal]", "\"\<Normal\>\""}], ",", "NormalH", ",",
       "TumorH"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"data", "=", 
    RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"panel", "=", 
    RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"lowFPKM", "=", "0.6"}], ";", "\[IndentingNewLine]", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"limit", "=", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"2", ",", "lowFPKM"}], "]"}], "-", 
        RowBox[{"Log", "[", 
         RowBox[{"2", ",", 
          RowBox[{"referenceN", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"threshold", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"values", "[", 
         RowBox[{"[", 
          RowBox[{"conceptextents", ",", "i"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"aberrations", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"values", "[", 
          RowBox[{"[", 
           RowBox[{"roughextents", ",", "i"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", ">", "threshold"}], "&&", 
           RowBox[{"#", ">", "limit"}]}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "aberrations", "]"}], ">", 
         RowBox[{"pvaluethreshold", "[", "whorough", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"threshold", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"threshold", "+", 
             RowBox[{"Min", "[", "aberrations", "]"}]}], ")"}], "/", "2"}]}], 
