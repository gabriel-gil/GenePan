  RowBox[{"total", "=", "0"}], ";", 
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"total", "<", "totalnormal"}], "&&", 
     RowBox[{"iter", "<=", 
      RowBox[{"Length", "[", "sel", "]"}]}], "&&", 
     RowBox[{"flag", "!=", "0"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"range", "=", 
      RowBox[{"uComplement", "[", 
       RowBox[{"sel", ",", "presel"}], "]"}]}], ";", 
     RowBox[{"list", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"Boole", "[", 
