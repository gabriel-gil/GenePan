Cell[BoxData[
 RowBox[{
  RowBox[{"iter", "=", "1"}], ";", 
  RowBox[{"flag", "=", "1"}], ";", 
  RowBox[{"presel", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"total", "=", "0"}], ";", 
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"total", "<", "totaltumor"}], "&&", 
     RowBox[{"iter", "<=", 
      RowBox[{"Length", "[", "sel", "]"}]}], "&&", 
     RowBox[{"flag", "!=", "0"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"range", "=", 
      RowBox[{"uComplement", "[", 
       RowBox[{"sel", ",", "presel"}], "]"}]}], ";", 
     RowBox[{"list", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"Boole", "[", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{"TumorH", ",", "#"}], "]"}], "&"}], ",", 
             RowBox[{"RE", "[", 
              RowBox[{
               RowBox[{"Append", "[", 
                RowBox[{"presel", ",", "#"}], "]"}], ",", "data"}], "]"}]}], 
            "]"}], "]"}], "]"}], "&"}], ",", "range"}], "]"}]}], ";", 
     RowBox[{"poslist", "=", 
      RowBox[{"First", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"list", ",", 
          RowBox[{"Max", "[", "list", "]"}]}], "]"}], "]"}], "]"}]}], ";", 
