  RowBox[{
   RowBox[{"pvaluethresholdplus", "[", "var_", "]"}], ":=", 
   RowBox[{"First", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Position", "[", 
      RowBox[{
       RowBox[{"Floor", "[", 
