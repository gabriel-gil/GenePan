           RowBox[{"referenceN", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sorted", "=", 
        RowBox[{"Sort", "[", 
