Cell[BoxData[
 RowBox[{"Timing", "[", 
  RowBox[{
   RowBox[{"whoconcept", "=", "\"\<Tumor\>\""}], ";", "\[IndentingNewLine]", 
   RowBox[{"conceptextents", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whoconcept", "\[Equal]", "\"\<Tumor\>\""}], ",", "TumorH", ",",
       "NormalH"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"whorough", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whoconcept", "\[Equal]", "\"\<Tumor\>\""}], ",", 
      "\"\<Normal\>\"", ",", "\"\<Tumor\>\""}], "]"}]}], ";", 
   RowBox[{"roughextents", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whorough", "\[Equal]", "\"\<Normal\>\""}], ",", "NormalH", ",",
       "TumorH"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"data", "=", 
    RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"panel", "=", 
    RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"thresholddown", "=", 
       RowBox[{"Min", "[", 
        RowBox[{"values", "[", 
         RowBox[{"[", 
          RowBox[{"conceptextents", ",", "i"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"thresholdup", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"values", "[", 
         RowBox[{"[", 
          RowBox[{"conceptextents", ",", "i"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"aberrations", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"values", "[", 
          RowBox[{"[", 
           RowBox[{"roughextents", ",", "i"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "<", "thresholddown"}], "||", 
           RowBox[{"#", ">", "thresholdup"}]}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"naberr", "=", 
       RowBox[{"Length", "[", "aberrations", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"naberr", ">", 
         RowBox[{"pvaluethreshold", "[", "whorough", "]"}]}], ",", 
        RowBox[{
         RowBox[{"pvaluethresholdplusab", "=", 
          RowBox[{"pvaluethresholdplus", "[", "naberr", "]"}]}], ";", 
         RowBox[{"abunder", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"aberrations", ",", 
            RowBox[{
             RowBox[{"#", "<", "thresholddown"}], "&"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"nabunder", "=", 
          RowBox[{"Length", "[", "abunder", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"nabunder", ">", "pvaluethresholdplusab"}], "&&", 
            RowBox[{
             RowBox[{"naberr", "-", "nabunder"}], ">", 
             "pvaluethresholdplusab"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"thresholddown", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"thresholddown", "+", 
                RowBox[{"Max", "[", "abunder", "]"}]}], ")"}], "/", "2"}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"thresholdup", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"thresholdup", "+", 
                RowBox[{"Min", "[", 
                 RowBox[{"uComplement", "[", 
                  RowBox[{"aberrations", ",", "abunder"}], "]"}], "]"}]}], 
               ")"}], "/", "2"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"panel", ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"{", 
                 RowBox[{"thresholddown", ",", "thresholdup"}], "}"}], ",", 
                "5"}], "}"}]}], "]"}], ";", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"data", ",", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"2", "-", 
                    RowBox[{"2", "^", 
                    RowBox[{"g", "[", 
                    RowBox[{"#", ",", "thresholddown"}], "]"}]}]}], ")"}], 
                  "+", 
                  RowBox[{"g", "[", 
                   RowBox[{"#", ",", "thresholdup"}], "]"}]}], "&"}], ",", 
                RowBox[{"values", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "i"}], "]"}], "]"}]}], "]"}]}], 
             "]"}]}]}], "]"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"values", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], "}"}]}], "]"}], 
   ";", "\[IndentingNewLine]", 
