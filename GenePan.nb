Cell[BoxData[
 RowBox[{"Timing", "[", 
  RowBox[{
   RowBox[{"whoconcept", "=", "\"\<Tumor\>\""}], ";", "\[IndentingNewLine]", 
   RowBox[{"conceptextents", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whoconcept", "\[Equal]", "\"\<Tumor\>\""}], ",", "TumorH", ",",
       "NormalH"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"whorough", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whoconcept", "\[Equal]", "\"\<Tumor\>\""}], ",", 
      "\"\<Normal\>\"", ",", "\"\<Tumor\>\""}], "]"}]}], ";", 
   RowBox[{"roughextents", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whorough", "\[Equal]", "\"\<Normal\>\""}], ",", "NormalH", ",",
       "TumorH"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"data", "=", 
    RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"panel", "=", 
    RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"threshold", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"values", "[", 
         RowBox[{"[", 
          RowBox[{"conceptextents", ",", "i"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"aberrations", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"values", "[", 
          RowBox[{"[", 
           RowBox[{"roughextents", ",", "i"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"#", ">", "threshold"}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "aberrations", "]"}], ">", 
         RowBox[{"pvaluethreshold", "[", "whorough", "]"}]}], ",", 
        RowBox[{
         RowBox[{"threshold", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"threshold", "+", 
             RowBox[{"Min", "[", "aberrations", "]"}]}], ")"}], "/", "2"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"panel", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "threshold", ",", "1"}], "}"}]}], "]"}], ";", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"data", ",", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"g", "[", 
               RowBox[{"#", ",", "threshold"}], "]"}], "&"}], ",", 
             RowBox[{"values", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "i"}], "]"}], "]"}]}], "]"}]}], "]"}]}]}], 
       "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"values", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], "}"}]}], "]"}], 
   ";", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"Boole", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"roughextents", ",", "#"}], "]"}], "&"}], ",", 
         RowBox[{"RE", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"1", ",", 
             RowBox[{"Length", "[", "data", "]"}]}], "]"}], ",", "data"}], 
          "]"}]}], "]"}], "]"}], "]"}], "/", 
     RowBox[{"Length", "[", "roughextents", "]"}]}], "]"}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"panellist", "=", 
    RowBox[{"{", "}"}]}], ";", 
   RowBox[{"panellist", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"panellist", ",", "panel"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"paneltumor", "=", 
    RowBox[{"{", "}"}]}], ";", 
   RowBox[{"paneltumor", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"paneltumor", ",", "panel"}], "]"}]}], ";", 
