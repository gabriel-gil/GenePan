Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Timing", "[", 
  RowBox[{
   RowBox[{"whoconcept", "=", "\"\<Tumor\>\""}], ";", "\[IndentingNewLine]", 
   RowBox[{"conceptextents", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whoconcept", "\[Equal]", "\"\<Tumor\>\""}], ",", "TumorH", ",",
       "NormalH"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"whorough", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whoconcept", "\[Equal]", "\"\<Tumor\>\""}], ",", 
      "\"\<Normal\>\"", ",", "\"\<Tumor\>\""}], "]"}]}], ";", 
   RowBox[{"roughextents", "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"whorough", "\[Equal]", "\"\<Normal\>\""}], ",", "NormalH", ",",
       "TumorH"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"data", "=", 
    RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"panel", "=", 
    RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"nc", "=", 
    RowBox[{"Length", "[", "conceptextents", "]"}]}], ";", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"sorted", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{
         RowBox[{"values", "[", 
          RowBox[{"[", 
           RowBox[{"conceptextents", ",", "i"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"#1", "<=", "#2"}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"diff", "=", 
       RowBox[{"Differences", "[", "sorted", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pos", "=", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{"diff", ",", 
           RowBox[{"Max", "[", "diff", "]"}]}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"thresholddown", "=", 
       RowBox[{"sorted", "[", 
        RowBox[{"[", "pos", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"thresholdup", "=", 
       RowBox[{"sorted", "[", 
        RowBox[{"[", 
         RowBox[{"pos", "+", "1"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"thresholdup", "-", "thresholddown"}], ">", "0.5"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"aberrations", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"values", "[", 
             RowBox[{"[", 
              RowBox[{"roughextents", ",", "i"}], "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"thresholddown", "<", "#", "<", "thresholdup"}], "&"}]}],
            "]"}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "aberrations", "]"}], ">", 
            RowBox[{"pvaluethreshold", "[", "whorough", "]"}]}], ",", 
           RowBox[{
            RowBox[{"ncunder", "=", 
             RowBox[{"Length", "[", 
              RowBox[{"Select", "[", 
               RowBox[{
                RowBox[{"values", "[", 
                 RowBox[{"[", 
                  RowBox[{"conceptextents", ",", "i"}], "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"#", "<", "thresholddown"}], "&"}]}], "]"}], "]"}]}],
             ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ncunder", ">", 
                RowBox[{"pvaluethresholdplus", "[", "nc", "]"}]}], "&&", 
               RowBox[{
                RowBox[{"nc", "-", "ncunder"}], ">", 
                RowBox[{"pvaluethresholdplus", "[", "nc", "]"}]}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"thresholddown", "=", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"thresholddown", "+", 
                   RowBox[{"Min", "[", "aberrations", "]"}]}], ")"}], "/", 
                 "2"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"thresholdup", "=", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"thresholdup", "+", 
                   RowBox[{"Max", "[", "aberrations", "]"}]}], ")"}], "/", 
                 "2"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"panel", ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", 
                   RowBox[{"{", 
                    RowBox[{"thresholddown", ",", "thresholdup"}], "}"}], ",",
                    "7"}], "}"}]}], "]"}], ";", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"data", ",", 
                 RowBox[{"Map", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"2", "-", 
                    RowBox[{"2", "^", 
                    RowBox[{"g", "[", 
                    RowBox[{"#", ",", "thresholdup"}], "]"}]}]}], ")"}], 
                    RowBox[{"g", "[", 
                    RowBox[{"#", ",", "thresholddown"}], "]"}]}], "&"}], ",", 
                   RowBox[{"values", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "i"}], "]"}], "]"}]}], "]"}]}], 
                "]"}]}]}], "]"}]}]}], "]"}]}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"values", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], "}"}]}], "]"}], 
   ";", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"Boole", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"roughextents", ",", "#"}], "]"}], "&"}], ",", 
         RowBox[{"RE", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"1", ",", 
             RowBox[{"Length", "[", "data", "]"}]}], "]"}], ",", "data"}], 
          "]"}]}], "]"}], "]"}], "]"}], "/", 
     RowBox[{"Length", "[", "roughextents", "]"}]}], "]"}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"panellist", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"panellist", ",", "panel"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"paneltumor", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"paneltumor", ",", "panel"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"datatumor", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"datatumor", ",", "data"}], "]"}]}], ";", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<panel7.dat\>\"", ",", "panel"}], "]"}], ";", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<paneltumormix.dat\>\"", ",", "paneltumor"}], "]"}], ";"}], 
  "]"}]], "Input",
