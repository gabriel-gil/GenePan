    "\[IndentingNewLine]", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"limit", "=", 
        RowBox[{
         RowBox[{"Log", "[", 
