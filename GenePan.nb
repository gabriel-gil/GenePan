        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"Boole", "[", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{"TumorH", ",", "#"}], "]"}], "&"}], ",", 
             RowBox[{"RE", "[", 
              RowBox[{
               RowBox[{"Append", "[", 
                RowBox[{"presel", ",", "#"}], "]"}], ",", "data"}], "]"}]}], 
            "]"}], "]"}], "]"}], "&"}], ",", "range"}], "]"}]}], ";", 
     RowBox[{"poslist", "=", 
      RowBox[{"First", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"list", ",", 
          RowBox[{"Max", "[", "list", "]"}]}], "]"}], "]"}], "]"}]}], ";", 
     RowBox[{"flag", "=", 
      RowBox[{
       RowBox[{"list", "[", 
        RowBox[{"[", "poslist", "]"}], "]"}], "-", "total"}]}], ";", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"flag", "!=", "0"}], ",", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"presel", ",", 
         RowBox[{"range", "[", 
          RowBox[{"[", "poslist", "]"}], "]"}]}], "]"}]}], "]"}], ";", 
     RowBox[{"total", "=", 
      RowBox[{"list", "[", 
       RowBox[{"[", "poslist", "]"}], "]"}]}], ";", 
     RowBox[{"iter", "++"}]}]}], "]"}], ";"}]], "Input",
