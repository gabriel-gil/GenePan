Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"pvaluethresholdplus", "[", "var_", "]"}], ":=", 
   RowBox[{"First", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Position", "[", 
      RowBox[{
       RowBox[{"Floor", "[", 
        RowBox[{"Clip", "[", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"Gamma", "[", 
                    RowBox[{"var", "+", "1"}], "]"}], "/", 
                   RowBox[{"Gamma", "[", 
                    RowBox[{"var", "-", "d", "+", "1"}], "]"}]}], "/", 
                  RowBox[{"Gamma", "[", 
                   RowBox[{"d", "+", "1"}], "]"}]}], 
                 RowBox[{"pp", "^", "d"}], " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"1", "-", "pp"}], ")"}], "^", 
                  RowBox[{"(", 
                   RowBox[{"var", "-", "d"}], ")"}]}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"d", ",", "0", ",", "#"}], "}"}]}], "]"}], "&"}], 
             ",", 
             RowBox[{"Range", "[", 
              RowBox[{"1", ",", "var"}], "]"}]}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"pvalue", ",", "pvalue"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "]"}], "]"}], ",", "1"}], "]"}], 
     "]"}], "]"}]}], ";"}]], "Input",
