               RowBox[{"values", "[", 
                RowBox[{"[", 
                 RowBox[{"trainingextents", ",", "i"}], "]"}], "]"}]}], 
              "]"}]}], "]"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
