Cell[BoxData[{
 RowBox[{
  RowBox[{"totaltumor", "=", 
   RowBox[{"Length", "[", "TumorH", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tumortrivial", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0.", ",", "totaltumor"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "1234", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"values", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "TumorH"}], "]"}], "]"}], "!=", "tumortrivial"}], 
       ",", 
       RowBox[{
        RowBox[{"d", "=", 
         RowBox[{"SmoothKernelDistribution", "[", 
          RowBox[{"values", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "TumorH"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"itumor", "=", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{"d", ",", "totaltumor"}], "]"}]}]}], ",", 
       RowBox[{"itumor", "=", "tumortrivial"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"values", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"values", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", "itumor"}], "]"}]}], ";"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"Range", "[", 
       RowBox[{"1", ",", 
        RowBox[{"Length", "[", "values", "]"}]}], "]"}]}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TumorH", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"TumorH", ",", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"ncsamples", "+", "1"}], ",", 
       RowBox[{"ncsamples", "+", "totaltumor"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
