          RowBox[{"values", "[", 
           RowBox[{"[", 
            RowBox[{"conceptextents", ",", "i"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"aberrations", "=", 
